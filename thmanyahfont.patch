 :root {
+  /* Typography — single family for Arabic and English.
+     Falls back to the plain @font-face name above if next/font's variable
+     is ever missing, then to system UI fonts. */
+  --font-sans: var(--font-thmanyah-sans, 'Thmanyah Sans'), 'Thmanyah Sans',
+    system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+
