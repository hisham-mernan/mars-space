 src/app/layout.js              | 32 ++++++++++----------------
 src/app/page.js                | 18 +++++++--------
 src/components/BookingModal.js | 30 ++++++++++++------------
 src/components/Header.js       |  2 +-
 src/context/LanguageContext.js |  7 ++++--
 6 files changed, 68 insertions(+), 63 deletions(-)

