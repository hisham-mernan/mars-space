--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1,10 +1,14 @@
 /* Mars Space Global Stylesheet - World-Class Handcrafted Design System */
 
-/* Comprehensive Local Font Face Declarations for Thmanyah Sans (OTF Primary, WOFF2 Secondary) */
+/* Thmanyah Sans — plain-CSS fallback layer.
+   The primary load path is next/font/local in app/layout.js (self-hosted +
+   preloaded, exposed as --font-thmanyah-sans). These @font-face rules only
+   come into play if that variable is ever unavailable, so the browser will
+   normally never fetch them. WOFF2 first, OTF for older engines. */
 @font-face {
   font-family: 'Thmanyah Sans';
-  src: url('/fonts/thmanyahsans/otf/thmanyahsans-Light.otf') format('opentype'),
-       url('/fonts/thmanyahsans/woff2/thmanyahsans-Light.woff2') format('woff2');
+  src: url('/fonts/thmanyahsans/woff2/thmanyahsans-Light.woff2') format('woff2'),
+       url('/fonts/thmanyahsans/otf/thmanyahsans-Light.otf') format('opentype');
   font-weight: 300;
   font-style: normal;
   font-display: swap;
