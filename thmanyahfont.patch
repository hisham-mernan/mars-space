-  font-family: 'IBM Plex Sans Arabic', var(--font-ibm-plex-sans-arabic), 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
+  font-family: var(--font-sans) !important;
   box-sizing: border-box;
 }
 
