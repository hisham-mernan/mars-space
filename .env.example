# Mars Space — environment variables
#
# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# .env* is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# Supabase (shared by the website and the mobile app)
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe to expose to browsers and to ship in the mobile
# app: every request it makes is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. BYPASSES ROW LEVEL SECURITY COMPLETELY.
# Server-side only, used by /erp and staff operations. Must never be prefixed
# NEXT_PUBLIC_, never reach a Client Component, and never enter the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local schema testing (scripts/db-test.sh)
# ---------------------------------------------------------------------------
# Connection string for a throwaway PostgreSQL used by `npm run db:test`.
# With the Supabase CLI running locally this is:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_URL=
